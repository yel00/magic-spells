# Settings for Magic Spells. None are required to start: the app runs with
# only a Spotify client ID, which can also be pasted on the welcome screen.
# On Vercel, add these under Settings → Environment Variables, then redeploy.
# For local development, copy this file to .env.local.

# Spotify app client ID (developer.spotify.com/dashboard). Not a secret.
# Leave unset to let each person paste their own on the welcome screen.
VITE_SPOTIFY_CLIENT_ID=

# --- Server-side keys (never sent to the browser) ---

# Song background, writers, producers, samples and covers. genius.com/api-clients
GENIUS_ACCESS_TOKEN=

# Better similar-artist data for discovery and the maps. last.fm/api/account/create
# Without it the app uses ListenBrainz, which needs no key.
LASTFM_API_KEY=

# Live performances inside the app. Google Cloud → YouTube Data API v3.
# Without it the app links out to YouTube.
YOUTUBE_API_KEY=

# Concert listings. developer.ticketmaster.com
TICKETMASTER_API_KEY=

# Past concerts and setlists. setlist.fm/settings/api (free for non-commercial use)
SETLISTFM_API_KEY=

# Tasting sessions (an AI guide). platform.claude.com → API keys. A session costs a few cents.
ANTHROPIC_API_KEY=
# Optional: only these Spotify user ids may run tasting sessions (comma-separated; each person's id is shown in their Settings). Unset = anyone who can sign in.
AI_ALLOWED_USERS=
# Optional: sessions each person may run per day. Default 30.
AI_DAILY_LIMIT=

# Postgres connection string, for syncing notes and tags between devices.
# Vercel's Neon integration sets this for you. Without it they stay on one device.
DATABASE_URL=
